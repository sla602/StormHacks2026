# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=d
# Model names change over time: run `python scripts/check_models.py` and update these
GEMINI_MODEL_FULL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3-flash-preview
# Model used by the voting agents (leave empty to use the LITE model)
GEMINI_MODEL_AGENT=

# --- ElevenLabs (https://elevenlabs.io/app/settings/api-keys) ---
ELEVENLABS_API_KEY=d
# eleven_flash_v2_5 = fast/cheap, eleven_multilingual_v2 = higher quality
ELEVENLABS_MODEL=eleven_flash_v2_5
# Free plans can only use premade voices. Run `python scripts/list_voices.py` to check.
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_BUSINESS=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ECO=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ETHICS=

DEFAULT_QUOTA_G=50
API_TIMEOUT_MS=20000
# 1 = never call Gemini; use rule-based votes + dummy responses (demo insurance)
FORCE_FALLBACK=0