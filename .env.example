# Copy this file to .env and fill in your own keys. Never commit .env.

# --- Name used in the agents' prompts (the website title lives in frontend/src/themes.js) ---
APP_NAME=TriBunal Council

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_key
# Model names change over time: run `python scripts/check_models.py` and update these
GEMINI_MODEL_FULL=gemini-3.5-flash
GEMINI_MODEL_LITE=gemini-3-flash-preview
# Model used by the voting agents (leave empty to use the LITE model)
GEMINI_MODEL_AGENT=

# --- ElevenLabs (https://elevenlabs.io/app/settings/api-keys) ---
ELEVENLABS_API_KEY=your_elevenlabs_key
# eleven_flash_v2_5 = fast/cheap, eleven_multilingual_v2 = higher quality
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional voice overrides. Leave them out to use the defaults in core/config.py.
# ELEVENLABS_VOICE_NARRATOR=   ELEVENLABS_VOICE_BUSINESS=   ELEVENLABS_VOICE_ECO=   ELEVENLABS_VOICE_ETHICS=
# ELEVENLABS_OTTER_NARRATOR=   ELEVENLABS_OTTER_BUSINESS=   ELEVENLABS_OTTER_ECO=   ELEVENLABS_OTTER_ETHICS=

DEFAULT_QUOTA_G=50
API_TIMEOUT_MS=20000
# 1 = never call Gemini; use rule-based votes + dummy responses (demo insurance)
FORCE_FALLBACK=0